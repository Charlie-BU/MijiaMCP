# Generate a key with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Set the value in Railway Variables. Never commit the actual key.
ALLOWED_API_KEYS='[]'
APP_PORT=8080
MIJIA_DATA_DIR=./.data
# OAuth access_token lifetime in seconds; positive integer or -1 for no expiration. No refresh_token.
# Expired connections must authorize again. Applies only to newly issued tokens.
ACCESS_TOKEN_EXPIRE_SECONDS=2592000
